# Copy to .env and fill in. .env is gitignored; this template is committed.
# Variables already set in your real environment take precedence over .env.

# Needed for `discover` and `make_logs --discover` only. Replay never calls a model.
ANTHROPIC_API_KEY=

# Credentials for the mock bank. Any values work: the mock app and the automation both read these.
MOCKBANK_USER=teller01
MOCKBANK_PASS=mock-only-password

# Optional model override (default claude-opus-5)
# AUTOMATION_MODEL=claude-opus-5
